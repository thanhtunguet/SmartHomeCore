# Controller the dev server proxies /api, /healthz and /readyz to (npm run dev).
HOMECORE_API_URL=http://127.0.0.1:8080

# Optional: call a Controller on another origin directly instead of using the proxy.
# That origin must list this UI's origin in controller.cors_allowed_origins.
# VITE_API_BASE=http://192.168.1.2:8080
