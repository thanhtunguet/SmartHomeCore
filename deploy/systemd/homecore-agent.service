# /etc/systemd/system/homecore-agent.service
# Runs unprivileged. Power actions are authorised by deploy/polkit/50-homecore-agent.rules.
[Unit]
Description=HomeCore Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homecore-agent
Group=homecore-agent
ExecStart=/usr/local/bin/homecore --mode agent --config /etc/homecore/agent.yaml
Environment=HOMECORE_DATA_DIR=/var/lib/homecore-agent
StateDirectory=homecore-agent
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5s

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# AF_UNIX is required to reach systemd-logind over D-Bus.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
