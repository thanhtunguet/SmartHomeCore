# /etc/systemd/system/homecore-controller.service
[Unit]
Description=HomeCore Controller
Documentation=https://github.com/thanhtunguet/homecore
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homecore
Group=homecore
ExecStart=/usr/local/bin/homecore --mode controller --config /etc/homecore/homecore.yaml
Environment=HOMECORE_DATA_DIR=/var/lib/homecore
StateDirectory=homecore
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5s

# Hardening: no privileges are needed (WOL broadcast and TCP probes are unprivileged).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
